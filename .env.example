# Required
API_KEY=change-me
SIGNING_SECRET=change-me-too
# Comma-separated origins (the Vercel domain)
ALLOWED_ORIGINS=https://cloudy-indol.vercel.app,http://localhost:3000

# Lyrics -> PowerPoint arrangement (LLM through OpenRouter). Without a key the
# lyrics route still works, using plain two-lines-per-slide grouping. The model
# is an OpenRouter preset that holds the system prompt.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=@preset/lyrics-generator
LLM_TIMEOUT_SECONDS=30

# Limits
MAX_CONCURRENT_JOBS=1
MAX_QUEUE=20
MAX_BATCH=10
# Songs per POST /v1/lyrics/pptx/batch request (converted one at a time)
MAX_LYRICS_BATCH=3
# Seconds of LLM time per lyrics batch; later songs fall back to plain grouping
LYRICS_BATCH_DEADLINE_SECONDS=45
# Largest request body in bytes (413 above it); raise it if you raise MAX_LYRICS_BATCH
MAX_REQUEST_BYTES=4194304
MAX_DURATION_SECONDS=1800
FILE_TTL_MINUTES=30
SIGNED_URL_TTL_SECONDS=600
# Parallel yt-dlp metadata probes when creating a job (lower to 1 if memory is tight)
PROBE_CONCURRENCY=3

# Video metadata (GET /v1|v2/videos, job preflight) through the YouTube Data API v3
# instead of yt-dlp/pytubefix probing, which triggers YouTube's bot check. Google
# Cloud console → enable "YouTube Data API v3" → create an API key restricted to
# that API. Empty → the download engine probes metadata itself (old behaviour).
YOUTUBE_DATA_API_KEY=

# Optional
# WORK_DIR=/tmp/cloudy
# Public base URL for signed links (defaults to RENDER_EXTERNAL_URL on Render,
# then to the request's base URL). On Railway set it to
# https://${{RAILWAY_PUBLIC_DOMAIN}}
# PUBLIC_BASE_URL=https://cloudy-api.onrender.com
# YTDLP_COOKIES_FILE=/etc/secrets/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port
# JS runtimes for YouTube challenges: comma-separated name[:path]
# (deno, node, bun, quickjs). yt-dlp prefers deno, then node.
# YTDLP_JS_RUNTIMES=deno,node
# yt-dlp --extractor-args (space-separated IE_KEY:ARGS); only if downloads fail
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,mweb

# /v2 API (pytubefix): temporary YouTube bot-check workaround. MWEB is the only
# client that fully worked from Railway; WEB_KIDS/IOS_KIDS only see YouTube Kids videos.
# PYTUBEFIX_CLIENT=MWEB
# PYTUBEFIX_PROXY=http://user:pass@host:port
